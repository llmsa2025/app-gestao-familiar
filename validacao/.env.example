# Copie para validacao/.env e preencha. O .env NÃO vai para o git.

# Dashboard da Pluggy (dashboard.pluggy.ai) → sua aplicação → Client ID / Client Secret
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# IDs das conexões (uma por banco autorizado via conector MeuPluggy), separados por vírgula
PLUGGY_ITEM_IDS=

# Quantos dias de extrato puxar (1 a 365)
DIAS=90
