# Copie para servidor/.env e preencha. O .env NUNCA vai para o git.
#
#   cp servidor/.env.example servidor/.env && chmod 600 servidor/.env
#
# Para gerar segredos fortes:
#   openssl rand -base64 33

# --- Banco gerenciado (Vercel) ---
# Uma URL só, a do POOLER do provedor (não a conexão direta). Quando definida, vale no
# lugar dos POSTGRES_* abaixo, que são do compose do VPS. Se faltar, o app usa o compose.
# DATABASE_URL=postgres://usuario:senha@host-do-pooler:5432/banco?sslmode=require
# Certificado da CA do banco (PEM, ou o PEM em base64 numa linha só). Obrigatório quando o
# Postgres tem certificado próprio (o do VPS ou o do Supabase). Na Vercel a conexão sem TLS
# verificado é recusada: ou DATABASE_CA, ou sslmode=verify-full na URL.
# DATABASE_CA=…
# Conexões por instância da função (padrão 3 na Vercel, 10 no VPS)
# PG_POOL_MAX=3
# Senha do cron da Vercel: a plataforma manda "Authorization: Bearer <CRON_SECRET>" em
# cada disparo de /api/cron/coletar. Sem ela a rota recusa tudo. openssl rand -base64 24
# CRON_SECRET=

# --- Banco do VPS (só dentro da rede do compose, sem porta publicada) ---
POSTGRES_DB=gestao_familia
POSTGRES_USER=gestao
POSTGRES_PASSWORD=

# --- Chave que cifra as credenciais da Pluggy guardadas no banco ---
# 32 bytes em base64. Se ela se perder, as credenciais salvas viram lixo e
# precisam ser cadastradas de novo — guarde uma cópia em lugar seguro.
CHAVE_MESTRA=

# --- Sessão do login ---
SEGREDO_SESSAO=

# --- App ---
PORTA=3200
# Endereço público do app (com https). É com ele que o app cadastra o aviso (webhook) na Pluggy.
URL_PUBLICA=https://gestao.seudominio.com.br
# Nome que aparece no topo do menu e na tela de entrada (padrão: "Minha Família").
# NOME_DA_FAMILIA=Família Silva
